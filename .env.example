# ==============================================================================
# Flint-nvfp4 Sandbox Environment Configuration
# Copy this file to .env and adjust variables for your local machine.
# NEVER commit your local .env to version control.
# ==============================================================================

# Path to the flint-nvfp4.gguf weights on your host filesystem.
# In WSL2/Windows, specify the Windows path format accessible by wslc (e.g. C:/models/... or C:/path/to/models/...):
MODEL_PATH=C:/models/flint-nvfp4.gguf

# Container image tag to build and run
IMAGE_TAG=flint-llama:fedora45-cuda

# Port to publish to the host loopback interface (127.0.0.1)
PORT=8080

# API key required by llama-server (Bearer token)
FLINT_API_KEY=your-secure-local-api-key-here

# Endpoint URL for chat completions (used by smoke tests and client scripts)
FLINT_API_URL=http://127.0.0.1:8080/v1/chat/completions

# Optional: Tailscale MagicDNS endpoint (omit or leave empty if not serving over Tailnet)
TAILNET_ENDPOINT=
